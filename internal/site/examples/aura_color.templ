package examples

import "github.com/romshark/morpheus/neo"

templ AuraColor() {
	<neo-layout wrap gap="lg" align-items="center">
		@neo.AuraAttrs(neo.AuraOpts{}, templ.Attributes{"class": "aura-color-live"}) {
			@neo.Badge(neo.BadgeOpts{Variant: neo.Set(neo.BadgeVariantDanger)}) {
				Live
			}
		}
		@neo.AuraAttrs(neo.AuraOpts{}, templ.Attributes{"class": "aura-color-sync"}) {
			@neo.Badge(neo.BadgeOpts{Variant: neo.Set(neo.BadgeVariantPrimary)}) {
				Syncing
			}
		}
	</neo-layout>
}
