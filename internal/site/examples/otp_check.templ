package examples

import "github.com/romshark/morpheus/neo"

templ OTPCheck() {
	@neo.LayoutAttrs(neo.LayoutOpts{
		Direction:  neo.Set(neo.Column),
		AlignItems: neo.Set(neo.AlignItemsFlexStart),
		Gap:        neo.Set(neo.GapSm),
	}, templ.Attributes{"data-signals": "{otp_check_code: ''}"}) {
		<label>
			@neo.Layout(neo.LayoutOpts{
				Direction:  neo.Set(neo.Column),
				AlignItems: neo.Set(neo.AlignItemsFlexStart),
				Gap:        neo.Set(neo.GapSm),
			}) {
				Verification code
				@neo.OTPAttrs(neo.OTPOpts{Name: neo.Set("code")}, templ.Attributes{
					"data-on:neo-otp-input": "$otp_check_code = evt.detail.value",
				})
			}
		</label>
		<span class="otp-check-tip">The correct PIN is 123456</span>
		<div role="status">
			@neo.LayoutAttrs(neo.LayoutOpts{
				AlignItems: neo.Set(neo.AlignItemsCenter),
				Gap:        neo.Set(neo.GapXs),
			}, templ.Attributes{
				"class":     "otp-check-correct",
				"data-show": "$otp_check_code === '123456'",
			}) {
				@neo.Icon("circle-check")
				Correct
			}
			@neo.LayoutAttrs(neo.LayoutOpts{
				AlignItems: neo.Set(neo.AlignItemsCenter),
				Gap:        neo.Set(neo.GapXs),
			}, templ.Attributes{
				"class":     "otp-check-wrong",
				"data-show": "$otp_check_code.length === 6 && $otp_check_code !== '123456'",
			}) {
				@neo.Icon("circle-x")
				Wrong
			}
		</div>
	}
}
