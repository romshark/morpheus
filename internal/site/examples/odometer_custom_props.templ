package examples

import "github.com/romshark/morpheus/neo"

templ OdometerCustomProps() {
	@neo.OdometerAttrs(templ.Attributes{
		"style":                              "font-size: 2.5rem",
		"data-signals":                       "{odometer_speed: 1.5, odometer_up: true, odometer_easing: 'linear(0, 0.063, 0.25, 0.563, 1 36.4%, 0.812, 0.75, 0.813, 1 72.7%, 0.953, 0.938, 0.953, 1 90.9%, 0.984, 1)'}",
		"data-style:--neo-odometer-duration": "1000 / $odometer_speed + 'ms'",
		"data-style:--neo-odometer-easing":   "$odometer_easing",
		"data-effect":                        "clearInterval(el.timer); $odometer_speed > 0 && (el.timer = setInterval(() => el.isConnected && el.dataset.effect ? el.textContent = Number(el.textContent) + ($odometer_up ? 1 : -1) : clearInterval(el.timer), 1000 / $odometer_speed))",
	}) {
		990
	}
}
