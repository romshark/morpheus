package examples

import "github.com/romshark/morpheus/neo"

templ CollapsibleReadMore() {
	<div class="collapsible-read-more">
		The cabin sits at the end of a gravel road, 20 minutes from the
		nearest village. It sleeps 4 in 2 bedrooms, and the living room
		opens onto a deck over the lake.
		@neo.CollapsibleAttrs(neo.CollapsibleOpts{}, templ.Attributes{
			"style": "display: flex; flex-direction: column-reverse",
		}) {
			<span slot="summary">Read more</span>
			<span slot="summary-open">Read less</span>
			<p>
				The kitchen has a wood stove, a gas range and a full set of
				cookware. Firewood is stacked by the door and restocked between
				stays.
			</p>
			<p>
				Check-in is from 3 PM with a key box at the door. Pets are
				welcome at 20 EUR per stay.
			</p>
		}
	</div>
}
