package examples

import "github.com/romshark/morpheus/neo"

templ OTPRTL() {
	@neo.LayoutAttrs(neo.LayoutOpts{
		Direction:  neo.Set(neo.Column),
		AlignItems: neo.Set(neo.AlignItemsFlexStart),
		Gap:        neo.Set(neo.GapMd),
	}, templ.Attributes{"dir": "rtl"}) {
		<label>
			@neo.Layout(neo.LayoutOpts{
				Direction:  neo.Set(neo.Column),
				AlignItems: neo.Set(neo.AlignItemsFlexStart),
				Gap:        neo.Set(neo.GapSm),
			}) {
				Verification code
				@neo.OTP(neo.OTPOpts{Value: neo.Set("482913")})
			}
		</label>
		<label>
			@neo.Layout(neo.LayoutOpts{
				Direction:  neo.Set(neo.Column),
				AlignItems: neo.Set(neo.AlignItemsFlexStart),
				Gap:        neo.Set(neo.GapSm),
			}) {
				Code in Arabic letters
				@neo.OTPAttrs(neo.OTPOpts{
					Mask:  neo.Set("****"),
					Value: neo.Set("أبجد"),
				}, templ.Attributes{"dir": "rtl", "autocomplete": "off"})
			}
		</label>
	}
}
