package site

import (
	"slices"

	"github.com/romshark/morpheus/internal/bundle"
	"github.com/romshark/morpheus/internal/href"
	"github.com/romshark/morpheus/neo"
)

templ PageBundleBuilder(morpheusVersion string, versions []BundleVersion) {
	@PageDoc(href.PageBundleBuilder(), "Bundle builder", morpheusVersion) {
		@templ.JSONScript("bundle-components",
			bundleURLData{Components: bundleURLComponents(), Versions: versions})
		@bundleURLBootstrap()
		<section class="demo" data-signals={ bundleSignals }>
			<neo-layout
				class="bundle-bulk-actions"
				justify-content="center"
				gap="md"
				wrap
			>
				@neo.SelectAttrs(neo.SelectOpts{
					Value:     neo.Set(versions[0].Name),
					AriaLabel: neo.Set("Version"),
				}, templ.Attributes{
					"data-attr:value":           bundleVersionSignal,
					"data-on:neo-select-change": bundleVersionChange(),
				}) {
					for i, v := range versions {
						@neo.Option(neo.OptionOpts{Value: neo.Set(v.Name)}) {
							{ bundleVersionLabel(versions, i) }
						}
					}
				}
				@neo.ButtonGroupAttrs(neo.ButtonGroupOpts{
					AriaLabel: neo.Set("Select or clear all components"),
				}, nil) {
					<neo-button data-on:click={ bundleEnableAllExpr }>
						Enable all
					</neo-button>
					<neo-button data-on:click={ bundleDisableAllExpr }>
						Disable all
					</neo-button>
				}
			</neo-layout>
			@neo.NavGroupAttrs(neo.NavGroupOpts{
				Orientation: neo.Set(neo.OrientationGrid),
				Wrap:        neo.Set(true),
				Typeahead:   neo.Set(true),
			}, templ.Attributes{
				"class":      "bundle-toggle-grid",
				"role":       "group",
				"aria-label": "Components in the bundle",
			}) {
				for _, nd := range bundle.Nodes() {
					if nd.Selectable() {
						{{ lacks := slices.Contains(versions[0].Absent, nd.ID) }}
						@neo.ToggleAttrs(neo.ToggleOpts{
							Pressed:  neo.Set(!lacks),
							Disabled: neo.Set(bundleInitiallyLocked(nd) || lacks),
							Size:     neo.Set("sm"),
							Value:    neo.Set(nd.Name),
						}, templ.Attributes{
							"data-neo-navgroup-item":    true,
							"data-attr:pressed":         bundleTogglePressed(nd),
							"data-attr:disabled":        bundleToggleLock(nd),
							"data-on:neo-toggle-change": bundleToggleChange(nd),
						}) {
							{ nd.ShortName() }
						}
					}
				}
			}
			<div id="bundle-size" class="bundle-size" data-state="building">
				<div class="bundle-size-overlay" aria-hidden="true">
					<neo-spinner></neo-spinner>
					<span class="bundle-size-overlay-label">Building bundle…</span>
				</div>
				<div class="bundle-size-body">
					<neo-layout
						class="bundle-size-head"
						align-items="baseline"
						justify-content="space-between"
						gap="md"
						wrap
					>
						<h2>Bundle size</h2>
						<span
							class="bundle-size-count"
							aria-live="polite"
							data-text={ bundleCountText }
						></span>
					</neo-layout>
					<p
						id="bundle-size-status"
						class="bundle-size-status"
						aria-live="polite"
					>Building bundle…</p>
					<div class="bundle-size-scroll">
						<table class="bundle-size-table">
							<thead>
								<tr>
									<th scope="col"></th>
									<th scope="col">Uncompressed</th>
									<th scope="col">
										gzip
										@bundleSizeInfo("gzip") {
											<p>
												Level 6, the <code>gzip</code> default.
												Level 9 saves under 1% more.
											</p>
										}
									</th>
									<th scope="col">
										brotli
										@bundleSizeInfo("brotli") {
											<p>
												Quality 11, the maximum, as used for precompressed
												files. On-the-fly compression uses a lower quality
												and produces larger files.
											</p>
										}
									</th>
								</tr>
							</thead>
							<tbody>
								for _, f := range bundleFiles {
									<tr data-file={ f.Key }>
										<th scope="row">
											<label class="bundle-size-file">
												@neo.Checkbox(neo.CheckboxOpts{
													Checked: neo.Set(f.Zip),
													Size:    neo.Set("sm"),
													AriaLabel: neo.Set(
														"Include " +
															f.Name() +
															" in morpheus.zip",
													),
												})
												<span>
													<span class="bundle-size-file-base">
														morpheus
													</span>
													<wbr/>
													{ "." + f.Key }
												</span>
											</label>
										</th>
										<td class="bundle-size-raw">
											<span data-size="raw">-</span>
											@bundleCopyButton(f.Name())
										</td>
										<td data-size="gzip">-</td>
										<td data-size="br">-</td>
									</tr>
								}
								<tr class="bundle-size-total">
									<th scope="row">Total</th>
									<td class="bundle-size-raw">
										<span data-size="raw">-</span>
										<span
											class="bundle-size-copy"
											aria-hidden="true"
										></span>
									</td>
									<td data-size="gzip">-</td>
									<td data-size="br">-</td>
								</tr>
							</tbody>
						</table>
					</div>
					<neo-layout class="bundle-size-downloads" justify-content="center">
						@neo.LinkAttrs(neo.LinkOpts{
							Variant:  neo.Set(neo.LinkVariantButtonPrimary),
							Download: neo.Set("morpheus.zip"),
							Disabled: neo.Set(true),
						}, templ.Attributes{"id": "bundle-download"}) {
							@neo.Icon("download")
							Download morpheus.zip
						}
					</neo-layout>
					<p class="bundle-size-note">Built in your browser with esbuild.</p>
				</div>
			</div>
			<span
				hidden
				aria-hidden="true"
				data-effect={ bundleSizeUpdate }
			></span>
		</section>
		<section class="demo">
			@anchoredH2("command-line") {
				Command line
			}
			<p>
				The <code>morpheus</code> command builds the same files
				without a browser. It needs Go, and the version after
				<code>{ "@" }</code> selects the release it builds:
			</p>
			<div class="theming-source">
				<site-codemirror language="bash" readonly>
					<template>{ bundleCLIRun(morpheusVersion) }</template>
				</site-codemirror>
			</div>
			<p>
				<code>-components</code> takes the names on this page,
				comma-separated, and adds the components they require.
				The command writes <code>morpheus.min.js</code> and
				<code>morpheus.min.css</code> to the <code>-o</code>
				directory and prints their sizes. With <code>-json</code>
				it prints the result as JSON, and with
				<code>-unminified</code> it also writes
				<code>morpheus.js</code> and <code>morpheus.css</code>.
			</p>
			<p>
				In a Go module, add the command as a tool. It then builds
				the version the module requires, which the
				<code>neo</code> and <code>datastar</code> packages come from:
			</p>
			<div class="theming-source">
				<site-codemirror language="bash" readonly>
					<template>{ bundleCLITool(morpheusVersion) }</template>
				</site-codemirror>
			</div>
			<p>
				<code>morpheus components</code> lists the names with the
				components each requires, and
				<code>morpheus bundle -h</code> lists the flags.
			</p>
		</section>
		<script>
			// Buffers the latest update until bundlebuilder.min.js loads.
			window.__bundleSizeUpdate = function (s, v) {
				window.__bundleSizePending = [s, v];
			};
		</script>
		<script type="module" src={ href.Asset("min/bundlebuilder.min.js") }></script>
	}
}

// bundleURLBootstrap reads ?version=, ?components= and ?file= into
// window.__bundleURL, which seeds the Datastar signals. It parses names as
// [bundle.Select] does and adds their requirements. Its withDeps serves
// [bundleVersionChange] and [bundleToggleChange]. bundle-size.ts writes
// the URL back and runs the ?file= download.
templ bundleURLBootstrap() {
	<script>
		window.__bundleURL = (function () {
			var data = JSON.parse(document.getElementById("bundle-components").textContent);
			var query = new URLSearchParams(location.search);
			var absentBy = {};
			data.versions.forEach(function (v) {
				absentBy[v.name] = v.absent || [];
			});
			var version = query.get("version");
			var badVersion = null;
			if (version === null || !absentBy[version]) {
				badVersion = version;
				version = data.versions[0].name;
			}
			var ids = data.components.map(function (c) {
				return c.id;
			});
			var depsByID = {};
			data.components.forEach(function (c) {
				depsByID[c.id] = c.deps || [];
			});
			function absentIn(v) {
				return absentBy[v] || [];
			}
			// The ids in sel and their requirements that version v has, in ids order.
			function withDeps(sel, v) {
				var picked = {};
				sel.forEach(function (id) {
					picked[id] = true;
					(depsByID[id] || []).forEach(function (d) {
						picked[d] = true;
					});
				});
				return ids.filter(function (id) {
					return picked[id] && absentIn(v).indexOf(id) < 0;
				});
			}
			var named = ids;
			var unknown = [];
			var missing = [];
			if (query.has("components")) {
				var byName = {};
				data.components.forEach(function (c) {
					byName[c.name] = c;
				});
				named = [];
				query.getAll("components").join(",").split(",").forEach(function (raw) {
					var name = raw.trim().toLowerCase().replace(/^neo-/, "");
					var c = byName[name];
					if (!c) {
						if (name) unknown.push(raw.trim());
					} else if (absentIn(version).indexOf(c.id) >= 0) {
						missing.push(c.name);
					} else {
						named.push(c.id);
					}
				});
			}
			return {
				components: data.components,
				ids: ids,
				defaultVersion: data.versions[0].name,
				version: version,
				selected: withDeps(named, version),
				unknown: unknown,
				missing: missing,
				badVersion: badVersion,
				file: query.get("file"),
				absent: absentIn,
				withDeps: withDeps,
			};
		})();
	</script>
}

// bundleSizeInfo is an info button whose popover explains a size column.
templ bundleSizeInfo(label string) {
	@neo.PopoverAttrs(neo.PopoverOpts{
		Placement: neo.Set(neo.PlacementBottomEnd),
	}, templ.Attributes{"class": "bundle-size-info"}) {
		<neo-button
			{ neo.PopoverTrigger()... }
			variant="ghost"
			size="sm"
			aria-label={ "How the " + label + " size is measured" }
		>
			@neo.Icon("info")
		</neo-button>
		<div { neo.PopoverContent()... } class="bundle-size-info-text">
			{ children... }
		</div>
	}
}

// bundleCopyButton copies a built file once bundle-size.ts sets its
// value and enables it.
templ bundleCopyButton(file string) {
	@neo.ClipcopyAttrs(neo.ClipcopyOpts{}, templ.Attributes{"class": "bundle-size-copy"}) {
		<neo-button variant="ghost" size="sm" disabled aria-label={ "Copy " + file }>
			<span data-neo-clipcopy-idle>
				@neo.Icon("clipboard")
			</span>
			<span data-neo-clipcopy-copied>
				@neo.Icon("check")
			</span>
		</neo-button>
	}
}
