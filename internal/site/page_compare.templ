package site

import (
	"github.com/romshark/morpheus/internal/href"
	"github.com/romshark/morpheus/internal/site/examples"
)

templ PageCompare(morpheusVersion string) {
	@PageDoc(href.PageCompare(), "Compare", morpheusVersion) {
		// position.js registers /compare/position/{print,split,colored}/ for
		// the Server-set position example.
		<script type="module" src="/static/sim/compare/position.js"></script>
		<section class="demo">
			@overviewH2(href.PageCompare()) {
				Compare
			}
			<p class="intro">
				Component <code>{ "<neo-compare>" }</code> stacks 2 layers,
				such as 2 versions of a photo, and splits them with a divider.
				Dragging the divider shows more of 1 layer and less of the other.
			</p>
			@Playground(PlaygroundOpts{
				ID:     "compare-playground",
				States: comparePlaygroundStates(),
			})
			@anchoredH2("reference") {
				Reference
			}
			@ComponentDocs(compareDoc)
			@anchoredH3("interaction") {
				Interaction
			}
			<ul class="demo-note">
				<li>
					A drag anywhere on the element moves the divider. A drag
					that starts on the handle keeps the handle under the pointer.
				</li>
				<li>
					A click moves the divider to the pointer. A double-click or
					double-tap on the handle moves it to the center, unless
					<code>recenter</code> is <code>false</code>.
				</li>
				<li>The handle lifts while held and drops back on release.</li>
				<li>On a touch screen, a swipe across the axis scrolls the page.</li>
				<li>
					The handle is a slider. Arrow keys move the divider 1% the
					way they point, 10% with <neo-kbd key="shift">Shift</neo-kbd>,
					and to the limit they point at with
					<neo-kbd key="mod">Ctrl</neo-kbd>.
					<neo-kbd>PageUp</neo-kbd> and <neo-kbd>PageDown</neo-kbd> move
					it 10%, <neo-kbd>Home</neo-kbd> and <neo-kbd>End</neo-kbd> to
					<code>min</code> and <code>max</code>.
				</li>
				<li>
					The before layer is on the start side, which is the right
					side in a right-to-left page.
				</li>
				<li>With reduced motion, the divider moves without a transition.</li>
			</ul>
		</section>
		<section class="demo">
			@anchoredH2("examples") {
				Examples
			}
			@anchoredH3("vertical") {
				Vertical
			}
			<p class="demo-note">
				<code>vertical</code> puts the before layer on top and moves the
				divider up and down.
			</p>
			@demoFrameWith(DemoFrameOpts{
				StageMinHeight: "max-content",
				HTMLSource:     compareVerticalHTML,
				TemplSource:    compareVerticalTempl,
			}) {
				@examples.CompareVertical()
			}
			@anchoredH3("captions") {
				Captions
			}
			<p class="demo-note">
				A layer holds any content. Here each layer is an image with a
				caption, and the divider clips the caption with the image.
			</p>
			@demoFrameWith(DemoFrameOpts{
				StageMinHeight: "max-content",
				HTMLSource:     compareCaptionsHTML,
				TemplSource:    compareCaptionsTempl,
				CSSSource:      compareCaptionsCSS,
			}) {
				@examples.CompareCaptions()
			}
			@anchoredH3("html-layers") {
				HTML layers
			}
			<p class="demo-note">
				The layers need not be images. Here both layers hold the same
				page, a search bar over an order summary, styled with an old
				design and a new one. The layers are <code>inert</code>, which
				keeps their mock controls out of the tab order and lets a press
				on them drag the divider.
			</p>
			@demoFrameWith(DemoFrameOpts{
				StageMinHeight: "max-content",
				HTMLSource:     compareRedesignHTML,
				TemplSource:    compareRedesignTempl,
				CSSSource:      compareRedesignCSS,
			}) {
				@examples.CompareRedesign()
			}
			@anchoredH3("customized") {
				Customized
			}
			<p class="demo-note">
				The <code>handle</code> slot replaces the arrows, here with a
				grip icon. <code>--neo-compare-tilt</code> tilts the line,
				<code>::part(divider)</code> dashes it, and
				<code>::part(handle)</code> reshapes the handle, which
				<code>:state(grabbed)</code> stretches while it is held. Custom
				properties set the line width and the handle colors, and
				<code>min</code> and <code>max</code> keep the divider off the
				edges.
			</p>
			@demoFrameWith(DemoFrameOpts{
				StageMinHeight: "max-content",
				HTMLSource:     compareCustomizedHTML,
				TemplSource:    compareCustomizedTempl,
				CSSSource:      compareCustomizedCSS,
			}) {
				@examples.CompareCustomized()
			}
		</section>
		<section class="demo">
			@anchoredH2("examples-datastar") {
				Examples: Datastar
			}
			@anchoredH3("morphing-the-content") {
				Morphing the content
			}
			<p class="demo-note">
				The states swap the images and carry no <code>value</code>. A
				morph replaces the images, and the divider stays where it was.
				Drag the divider, then switch the state.
			</p>
			@Playground(PlaygroundOpts{
				ID:     "compare-morph-playground",
				States: compareMorphStates(),
			})
			@anchoredH3("server-set-position") {
				Server-set position
			}
			<p class="demo-note">
				Each button posts to the server, which renders the whole element
				with a new <code>value</code>. The morph changes only that
				attribute, and the divider eases to it. Drag the divider, then
				press a button.
			</p>
			@demoFrameWith(DemoFrameOpts{
				StageMinHeight: "max-content",
				HTMLSource:     compareServerHTML,
				TemplSource:    compareServerTempl,
				ScriptSource:   compareServerScript,
			}) {
				@examples.CompareServer()
			}
		</section>
	}
}

var compareDoc = ComponentDoc{
	Attributes: []DocAttribute{
		{Name: "value", Type: "number", Default: "50", Reflected: true, Observed: true,
			Description: templ.Raw("Divider position in percent from the start edge, clamped to <code>min</code> and <code>max</code>.")},
		{Name: "min", Type: "number", Default: "0", Observed: true,
			Description: templ.Raw("Lowest divider position, 0 to 100.")},
		{Name: "max", Type: "number", Default: "100", Observed: true,
			Description: templ.Raw("Highest divider position, 0 to 100. Below <code>min</code>, the divider stays at <code>min</code>.")},
		{Name: "vertical", Type: "boolean", Default: "false", Observed: true,
			Description: templ.Raw("Stacks the before layer above the after layer, with a horizontal divider.")},
		{Name: "disabled", Type: "boolean", Default: "false", Observed: true,
			Description: templ.Raw("Ignores pointer and keyboard input.")},
		{Name: "recenter", Type: "boolean", Default: "true",
			Description: templ.Raw("A double-click or double-tap on the handle moves the divider to the center. <code>recenter=\"false\"</code> turns it off.")},
		{Name: "divider-label", Type: "string", Default: "Divider position", Observed: true,
			Description: templ.Raw("Accessible name of the handle.")},
	},
	States: []DocState{
		{Name: "dragging",
			Description: templ.Raw("Set while a pointer drags the divider. The divider then moves without a transition.")},
		{Name: "grabbed",
			Description: templ.Raw("Set while the handle is held: from a press on the handle, or from the start of a drag elsewhere.")},
	},
	Slots: []DocSlot{
		{Name: "before", Description: templ.Raw("The layer on the start side, or on top when vertical.")},
		{Name: "after", Description: templ.Raw("The layer on the end side, or below when vertical.")},
		{Name: "handle", Description: templ.Raw("Content of the handle, 2 arrows by default.")},
	},
	Events: []DocEvent{
		{Name: "neo-compare-input", Detail: "{ value: number }", Bubbles: true,
			Description: templ.Raw("Fires on each move of a pointer drag.")},
		{Name: "neo-compare-change", Detail: "{ value: number }", Bubbles: true,
			Description: templ.Raw("Fires when a drag ends, a click or a key moves the divider, only if the value changed.")},
	},
	Parts: []DocPart{
		{Name: "before", Description: templ.Raw("Box of the before layer, clipped at the divider.")},
		{Name: "after", Description: templ.Raw("Box of the after layer, clipped at the divider.")},
		{Name: "divider", Description: templ.Raw("The line at the divider position.")},
		{Name: "handle", Description: templ.Raw("The focusable knob on the divider.")},
	},
	CSSProps: []DocCSSProp{
		{Name: "--neo-compare-tilt", Default: "0deg",
			Description: templ.Raw("Clockwise tilt of the divider. The range stretches by the tilt, which keeps 0 and 100 showing 1 layer fully.")},
		{Name: "--neo-compare-divider-width", Default: "2px",
			Description: templ.Raw("Width of the divider line.")},
		{Name: "--neo-compare-divider-color", Default: "var(--btn-bg)",
			Description: templ.Raw("Color of the divider line and of the handle background.")},
		{Name: "--neo-compare-shadow", Default: "0 0 4px rgb(0 0 0 / 0.35)",
			Description: templ.Raw("Shadow of the divider and the handle.")},
		{Name: "--neo-compare-handle-size", Default: "2.5rem",
			Description: templ.Raw("Diameter of the handle.")},
		{Name: "--neo-compare-handle-radius", Default: "50%",
			Description: templ.Raw("Corner radius of the handle.")},
		{Name: "--neo-compare-handle-grab-scale", Default: "1.15",
			Description: templ.Raw("Scale of the handle while it is held.")},
		{Name: "--neo-compare-handle-grab-shadow", Default: "0 4px 12px rgb(0 0 0 / 0.4)",
			Description: templ.Raw("Shadow of the handle while it is held.")},
		{Name: "--neo-compare-grab-duration", Default: "150ms",
			Description: templ.Raw("Duration of the handle lift and drop, multiplied by <code>--neo-duration-scale</code>.")},
		{Name: "--neo-compare-handle-bg", Default: "var(--neo-compare-divider-color)",
			Description: templ.Raw("Handle background.")},
		{Name: "--neo-compare-handle-fg", Default: "var(--btn-fg)",
			Description: templ.Raw("Color of the handle arrows.")},
		{Name: "--neo-compare-handle-border", Default: "var(--btn-border)",
			Description: templ.Raw("Color of the 1px handle border.")},
		{Name: "--neo-compare-focus-ring", Default: "var(--focus-ring, var(--accent))",
			Description: templ.Raw("Color of the handle focus outline.")},
		{Name: "--neo-compare-duration", Default: "200ms",
			Description: templ.Raw("Duration of a move that isn't a drag, multiplied by <code>--neo-duration-scale</code>.")},
		{Name: "--neo-compare-easing", Default: "var(--neo-easing, ease)",
			Description: templ.Raw("Easing of a move that isn't a drag.")},
	},
}
