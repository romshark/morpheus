package site

import (
	"github.com/romshark/morpheus/internal/href"
	"github.com/romshark/morpheus/internal/site/examples"
)

templ PageOdometer(morpheusVersion string) {
	@PageDoc(href.PageOdometer(), "Odometer", morpheusVersion) {
		// cart.js registers /odometer/cart/{add,remove}/ for the
		// Server-rendered total example.
		<script type="module" src="/static/sim/odometer/cart.js"></script>
		<section class="demo">
			@overviewH2(href.PageOdometer()) {
				Odometer
			}
			<p class="intro">
				Component <code>{ "<neo-odometer>" }</code> is a number that
				animates each change by rolling its digits. Put the formatted
				number inside it as text, such as <code>$1,234.56</code>. When
				the text changes, the digits roll to the new value.
			</p>
			@Playground(PlaygroundOpts{
				ID:     "odometer-playground",
				States: odometerPlaygroundStates(),
			})
			@anchoredH2("reference") {
				Reference
			}
			@ComponentDocs(odometerDoc)
			@anchoredH3("rolling") {
				Rolling
			}
			<ul class="demo-note">
				<li>
					Decimal digits of any script roll. A plus or minus sign
					slides in and out. Other characters change in place.
				</li>
				<li>
					Characters line up from the end, which keeps the last digit
					in place. Added and removed digits slide in and out.
				</li>
				<li>
					Digits roll up when the absolute value grows and down when
					it shrinks. Keep the number of fraction digits fixed, because
					the direction compares the digits as written.
				</li>
				<li>A new value mid-roll continues from where the digits are.</li>
				<li>Empty text keeps the current number.</li>
				<li>
					Screen readers read the text but don't announce changes.
					To announce them, wrap the element in an
					<code>aria-live</code> region.
				</li>
				<li>With reduced motion, the number changes without a roll.</li>
			</ul>
		</section>
		<section class="demo">
			@anchoredH2("examples") {
				Examples
			}
			@anchoredH3("formatted-values") {
				Formatted values
			}
			<p class="demo-note">
				The server formats the number, here in US dollars. The
				currency sign stays in place, and a comma slides in past
				$999.99.
			</p>
			@Playground(PlaygroundOpts{
				ID:       "odometer-formats-playground",
				Autoplay: true,
				States:   odometerFormatsStates(),
			})
			@anchoredH3("other-digit-scripts") {
				Other digit scripts
			}
			<p class="demo-note">
				Arabic-Indic digits roll like ASCII ones. In a right-to-left
				paragraph the digits still read left to right, and the unit
				follows the paragraph.
			</p>
			@Playground(PlaygroundOpts{
				ID:       "odometer-scripts-playground",
				Autoplay: true,
				States:   odometerScriptsStates(),
			})
		</section>
		<section class="demo">
			@anchoredH2("customization") {
				Customization
			}
			@anchoredH3("custom-properties") {
				Custom properties
			}
			<p class="demo-note">
				@AnchorCode("#css-variables-neo-odometer-duration", "--neo-odometer-duration")
				and @AnchorCode("#css-variables-neo-odometer-easing", "--neo-odometer-easing")
				set the roll, here from
				signals. The duration matches the count interval, which turns
				the digits without a pause.
			</p>
			@demoFrameWith(DemoFrameOpts{
				StageMinHeight: "max-content",
				HTMLSource:     odometerCustomPropsHTML,
				TemplSource:    odometerCustomPropsTempl,
			}) {
				@examples.OdometerCustomProps()
			}
			@anchoredH3("styling-parts") {
				Styling parts
			}
			<p class="demo-note"><code>::part()</code> styles the cells of each odometer.</p>
			<ul class="demo-note">
				<li>
					The visitor count puts each digit on a tile and mutes the
					separator and unit. The digits roll inside their tiles.
				</li>
				<li>
					The temperature underlines each digit, raises the unit and
					colors the sign, which slides in below 0.
				</li>
			</ul>
			@Playground(PlaygroundOpts{
				ID:       "odometer-parts-playground",
				Autoplay: true,
				States:   odometerPartsStates(),
			})
		</section>
		<section class="demo">
			@anchoredH2("examples-datastar") {
				Examples: Datastar
			}
			@anchoredH3("server-rendered-total") {
				Server-rendered total
			}
			<p class="demo-note">
				Each button posts to the server, which formats the new total
				and morphs it into the odometer. Add a pass to see the comma
				slide in.
			</p>
			@demoFrameWith(DemoFrameOpts{
				StageMinHeight: "max-content",
				HTMLSource:     odometerCartHTML,
				TemplSource:    odometerCartTempl,
				ScriptSource:   odometerCartScript,
			}) {
				@examples.OdometerCart()
			}
		</section>
	}
}

var odometerDoc = ComponentDoc{
	Slots: []DocSlot{
		{Name: "default",
			Description: templ.Raw("The number as text, formatted by the server.")},
	},
	Parts: []DocPart{
		{Name: "digit",
			Description: templ.Raw("A digit cell, which clips its rolling glyphs.")},
		{Name: "symbol",
			Description: templ.Raw("A separator or other character between the first and last digit.")},
		{Name: "prefix",
			Description: templ.Raw("The text before the first digit, such as a sign or currency.")},
		{Name: "suffix",
			Description: templ.Raw("The text after the last digit, such as a unit.")},
	},
	CSSProps: []DocCSSProp{
		{Name: "--neo-odometer-duration", Default: "600ms",
			Description: templ.Raw("Duration of a roll or width change, multiplied by <code>--neo-duration-scale</code>.")},
		{Name: "--neo-odometer-easing", Default: "var(--neo-easing, cubic-bezier(0.16, 1, 0.3, 1))",
			Description: templ.Raw("Easing of a roll or width change.")},
	},
}
