package site

import (
	"github.com/romshark/morpheus/internal/href"
	"github.com/romshark/morpheus/internal/site/examples"
)

templ PageIfNetwork(morpheusVersion string) {
	@PageDoc(href.PageIfNetwork(), "If network", morpheusVersion) {
		<section class="demo">
			@anchoredH2("overview") {
				If network
			}
			<p class="intro">
				Component <code>{ "<neo-if-network>" }</code> is a connection
				gate. It shows its content only while the browser is online
				(<code>online</code>) or offline (<code>{ `online="false"` }</code>),
				and switches when the connection changes. To require a
				platform too, nest it
				in @ComponentLink("neo-if-platform", href.PageIfPlatform())&period;
			</p>
			@anchoredH2("reference") {
				Reference
			}
			@ComponentDocs(ifNetworkDoc)
		</section>
		<section class="demo">
			@anchoredH2("examples") {
				Examples
			}
			@anchoredH3("connection-status") {
				Connection status
			}
			<p class="demo-note">
				One branch per connection state tells the user whether
				their changes reach the server.
			</p>
			<ul class="demo-note">
				<li>
					Because the <code>{ `role="status"` }</code> wrapper stays on the
					page, screen readers announce the branch that appears.
					A live region must be on the page before its content
					changes.
				</li>
				<li>
					<code>online</code> only means the device is on a
					network. A server that is down still counts as online.
				</li>
				<li>
					<code>{ `delay="2000"` }</code> switches only after the
					connection has changed for 2 seconds. A shorter drop shows
					nothing.
				</li>
				<li>
					In DevTools, set <code>Network</code> throttling to
					<code>Offline</code> and wait 2 seconds to see the other
					branch.
				</li>
			</ul>
			@demoFrameWith(DemoFrameOpts{
				StageMinHeight: "max-content",
				StageClass:     "demo-stage-flow",
				HTMLSource:     ifNetworkStatusHTML,
				TemplSource:    ifNetworkStatusTempl,
			}) {
				@examples.IfNetworkStatus()
			}
		</section>
	}
}

var ifNetworkDoc = ComponentDoc{
	Attributes: []DocAttribute{
		{Name: "online", Type: "boolean", Default: "unset", Observed: true,
			Description: templ.Raw("The connection state to show in. <code>online</code> shows while online, <code>online=\"false\"</code> while offline, and unset in both. Offline is reliable; online only means the device is on a network, not that the server is reachable.")},
		{Name: "delay", Type: "number", Default: "0",
			Description: templ.Raw("Milliseconds a connection change must last before the content switches. A shorter drop shows nothing. The state on page load applies at once.")},
	},
	Slots: []DocSlot{
		{Name: "default",
			Description: templ.Raw("Shown only in the connection state <code>online</code> selects.")},
	},
}
