package site

import (
	"github.com/romshark/morpheus/internal/href"
	"github.com/romshark/morpheus/internal/site/examples"
)

templ PageCollapsible(morpheusVersion string) {
	@PageDoc(href.PageCollapsible(), "Collapsible", morpheusVersion) {
		<section class="demo">
			@overviewH2(href.PageCollapsible()) {
				Collapsible
			}
			<p class="intro">
				Component <code>{ "<neo-collapsible>" }</code> is a summary button
				that shows and hides the content below it. Elements that share a @anchorCode("#attributes-name", "name")
				form a group, in which opening 1 closes the others.
				Unlike a native <code>{ "<details>" }</code>, it preserves its state
				when morph-patched (stays open if it was opened) and can optionally
				be server-controlled through the @anchorCode("#attributes-open", "open")
				attribute.
			</p>
			@Playground(PlaygroundOpts{
				ID:     "collapsible-playground",
				States: collapsiblePlaygroundStates(),
			})
			@anchoredH2("reference") {
				Reference
			}
			@ComponentDocs(collapsibleDoc)
			@anchoredH3("interaction") {
				Interaction
			}
			<ul class="demo-note">
				<li>
					A click on the summary, or <neo-kbd>Enter</neo-kbd> or
					<neo-kbd>Space</neo-kbd> on it, opens or closes the content.
				</li>
				<li>
					Closed content is out of the tab order and hidden from
					assistive tech. Closing moves focus from the content to the
					summary.
				</li>
				<li>
					Find-in-page matches closed content and opens the element, in
					browsers that support <code>{ `hidden="until-found"` }</code>.
				</li>
				<li>
					Content that changes size while open resizes at once. Wrap it
					in @ComponentLink("neo-elastic", href.PageElastic())&nbsp;to
					animate the change.
				</li>
				<li>With reduced motion, the content opens and closes without a transition.</li>
			</ul>
		</section>
		<section class="demo">
			@anchoredH2("examples") {
				Examples
			}
			@anchoredH3("accordion") {
				Accordion
			}
			<p class="demo-note">
				The 3 elements share @anchorCode("#attributes-name", `name="shipping-faq"`)&comma;
				and opening 1 closes the open one. The kit has no separate accordion
				component, because @anchorCode("#attributes-name", "name")
				already gives this behavior.
			</p>
			@demoFrameWith(DemoFrameOpts{
				StageMinHeight: "max-content",
				HTMLSource:     collapsibleAccordionHTML,
				TemplSource:    collapsibleAccordionTempl,
				CSSSource:      collapsibleAccordionCSS,
			}) {
				@examples.CollapsibleAccordion()
			}
			@anchoredH3("read-more") {
				Read more
			}
			<p class="demo-note">
				Only the hidden text is in the element, and the preview stays
				outside. <code>{ "flex-direction: column-reverse" }</code>
				on the element puts the panel above the summary, which keeps the
				button under the text it shows. The @anchorCode("#slots-summary-open", "summary-open")
				slot holds the label while open, and
				<code>{ "width: fit-content" }</code> on @anchorCode("#parts-summary", "::part(summary)")
				keeps the chevron next to the label.
			</p>
			@demoFrameWith(DemoFrameOpts{
				StageMinHeight: "max-content",
				HTMLSource:     collapsibleReadMoreHTML,
				TemplSource:    collapsibleReadMoreTempl,
				CSSSource:      collapsibleReadMoreCSS,
			}) {
				@examples.CollapsibleReadMore()
			}
			@anchoredH3("animated-trigger") {
				Animated trigger
			}
			<p class="demo-note">
				Same structure as Read more, but the summary holds both labels,
				stacked in a grid. @anchorCode("#attributes-open", `[open]:not([open="false"])`)
				selectors move 1 out and the other in while the color fades from
				the link color to the muted color. The @anchorCode("#slots-summary-open", "summary-open")
				slot can't do this, because it swaps the label without a
				transition. Open the element to see it.
			</p>
			@demoFrameWith(DemoFrameOpts{
				StageMinHeight: "max-content",
				HTMLSource:     collapsibleAnimatedTriggerHTML,
				TemplSource:    collapsibleAnimatedTriggerTempl,
				CSSSource:      collapsibleAnimatedTriggerCSS,
			}) {
				@examples.CollapsibleAnimatedTrigger()
			}
			@anchoredH3("customized") {
				Customized
			}
			<p class="demo-note">
				@anchorCode("#parts-summary", "::part(summary)")
				puts the icon before the label, and @anchorCode("#parts-icon", "::part(icon)")
				points the chevron at the label while closed. <a href="#css-variables">Custom properties</a> slow the transition and set the padding
				and the icon color.
			</p>
			@demoFrameWith(DemoFrameOpts{
				StageMinHeight: "max-content",
				HTMLSource:     collapsibleCustomizedHTML,
				TemplSource:    collapsibleCustomizedTempl,
				CSSSource:      collapsibleCustomizedCSS,
			}) {
				@examples.CollapsibleCustomized()
			}
			@anchoredH3("sidebar") {
				Sidebar
			}
			<p class="demo-note">
				Each nav section is a collapsible without a @anchorCode("#attributes-name", "name")&comma;
				which lets several stay open. Buttons in a closed section are out
				of the tab order. @anchorCode("#parts-summary", "::part(summary)")
				styles the summary as a section heading.
			</p>
			@demoFrameWith(DemoFrameOpts{
				StageMinHeight: "max-content",
				HTMLSource:     collapsibleSidebarHTML,
				TemplSource:    collapsibleSidebarTempl,
				CSSSource:      collapsibleSidebarCSS,
			}) {
				@examples.CollapsibleSidebar()
			}
		</section>
		<section class="demo">
			@anchoredH2("examples-datastar") {
				Examples: Datastar
			}
			@anchoredH3("morphing-state-and-content") {
				Morphing the state and the content
			}
			<p class="demo-note">
				Each state is a server render that a morph applies. The second
				state sets @anchorCode("#attributes-open", `open="true"`)&comma;
				which opens the element. The third keeps it and swaps the content for an alert,
				and the element stays open while the morph replaces the content.
				A @ComponentLink("neo-elastic", href.PageElastic())&nbsp;around the
				content animates the height change.
			</p>
			@Playground(PlaygroundOpts{
				ID:     "collapsible-morph-playground",
				States: collapsibleMorphStates(),
			})
		</section>
	}
}

var collapsibleDoc = ComponentDoc{
	Attributes: []DocAttribute{
		{Name: "open", Type: "boolean", Default: "false", Reflected: true, Observed: true,
			Description: templ.Raw("Shows the content.")},
		{Name: "name", Type: "string",
			Description: templ.Raw("Group name. Opening the element closes the others with the same <code>name</code> in the document or shadow root. If several are rendered open, the last one stays open, and the console logs a warning.")},
	},
	Slots: []DocSlot{
		{Name: "summary",
			Description: templ.Raw("Label of the summary button. Takes text and inline elements without links or controls, as a <code>&lt;button&gt;</code> does.")},
		{Name: "summary-open",
			Description: templ.Raw("Label of the summary button while open, in place of <a href=\"#slots-summary\"><code>summary</code></a>. Optional.")},
		{Name: "default",
			Description: templ.Raw("The content the element shows and hides.")},
	},
	Events: []DocEvent{
		{Name: "neo-collapsible-toggle", Detail: "{ open: boolean, item: HTMLElement }", Bubbles: true,
			Description: templ.Raw("Fires when a click, a key, find-in-page or the opening of a group member changes the state. A change of <a href=\"#attributes-open\"><code>open</code></a> on the element doesn't fire it.")},
	},
	Parts: []DocPart{
		{Name: "summary", Description: templ.Raw("The button that holds the label and the icon.")},
		{Name: "icon", Description: templ.Raw("The chevron, turned 180deg while open.")},
		{Name: "panel", Description: templ.Raw("Box of the content, which animates its height.")},
	},
	CSSProps: []DocCSSProp{
		{Name: "--neo-collapsible-duration", Default: "200ms",
			Description: templ.Raw("Duration of the open and close transition, multiplied by <code>--neo-duration-scale</code>.")},
		{Name: "--neo-collapsible-summary-padding", Default: "calc(var(--page-spacing) * 2) 0",
			Description: templ.Raw("Padding of the summary button.")},
		{Name: "--neo-collapsible-gap", Default: "calc(var(--page-spacing) * 2)",
			Description: templ.Raw("Space between the label and the icon.")},
		{Name: "--neo-collapsible-icon-size", Default: "1em",
			Description: templ.Raw("Width and height of the icon.")},
		{Name: "--neo-collapsible-icon-color", Default: "var(--muted)",
			Description: templ.Raw("Color of the icon.")},
		{Name: "--neo-collapsible-focus-ring", Default: "var(--focus-ring, var(--accent))",
			Description: templ.Raw("Color of the summary focus outline.")},
	},
}
