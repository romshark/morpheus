package neo

type SwitchOpts struct {
	Name Attr[string]
	// Value is what an on switch submits under Name. Unset is "on".
	Value    Attr[string]
	Checked  Attr[bool]
	Disabled Attr[bool]
	// Required makes the owning form invalid while off.
	Required  Attr[bool]
	Size      Attr[string]
	AriaLabel Attr[string]
}

// Switch prerenders <neo-switch> with role/aria-checked/tabindex
// matching the upgraded state, which lets the host paint once with no flicker.
templ Switch(opts SwitchOpts) {
	@SwitchAttrs(opts, nil)
}

// SwitchAttrs is [Switch] with an extra attribute set.
templ SwitchAttrs(opts SwitchOpts, attrs templ.Attributes) {
	<neo-switch
		role="switch"
		{ opts.Name.Attrs("name")... }
		{ opts.Value.Attrs("value")... }
		{ opts.Checked.Attrs("checked")... }
		if opts.Checked.Or(false) {
			aria-checked="true"
		} else {
			aria-checked="false"
		}
		if opts.Disabled.Or(false) {
			disabled
			aria-disabled="true"
			tabindex="-1"
		} else {
			tabindex="0"
		}
		{ opts.Required.Attrs("required")... }
		{ opts.Size.Attrs("size")... }
		{ opts.AriaLabel.Attrs("aria-label")... }
		{ attrs... }
	></neo-switch>
}
